<% content_for :title, @animal.name %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="bg-white border rounded p-4 shadow-sm">
      <h1 class="h4 border-bottom pb-2 mb-3"><%= @animal.name %></h1>

      <%= render @animal %>

      <div class="mt-3 pt-3 border-top d-flex gap-2">
        <%= link_to "Редагувати", edit_animal_path(@animal), class: "btn btn-outline-secondary btn-sm" %>
        <%= button_to "Видалити", @animal, method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      form: { data: { turbo_confirm: "Видалити запис про #{@animal.name}?" } } %>
      </div>
    </div>
  </div>
</div>
