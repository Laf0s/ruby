<% content_for :title, "Редагування" %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="bg-white border rounded p-4 shadow-sm">
      <h1 class="h4 border-bottom pb-2 mb-3">Редагувати: <%= @animal.name %></h1>
      <%= render "form", animal: @animal %>
      <div class="mt-3 pt-2 border-top">
        <%= link_to "Переглянути картку", @animal, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>
