<% content_for :title, "Тварини притулку" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Тварини притулку</h1>
  <span class="text-muted small">Всього записів: <%= @animals.count %></span>
</div>

<div class="bg-white border rounded p-3 shadow-sm">
  <ul class="nav nav-pills mb-3 border-bottom pb-3" id="pills-tab" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="pills-home-tab" data-bs-toggle="tab" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">
        Шукають дім (<%= @animals.count { |a| a.status == "Шукають дім" } %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="pills-adopted-tab" data-bs-toggle="tab" data-bs-target="#pills-adopted" type="button" role="tab" aria-controls="pills-adopted" aria-selected="false">
        Влаштовані (<%= @animals.count { |a| a.status == "Влаштовані" } %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="pills-help-tab" data-bs-toggle="tab" data-bs-target="#pills-help" type="button" role="tab" aria-controls="pills-help" aria-selected="false">
        Потрібна допомога (<%= @animals.count { |a| a.status == "Потрібна допомога" } %>)
      </button>
    </li>
  </ul>

  <div class="tab-content" id="pills-tabContent">
    <div class="tab-pane show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab" tabindex="0">
      <%= render "table", animals: @animals.select { |a| a.status == "Шукають дім" } %>
    </div>
    <div class="tab-pane" id="pills-adopted" role="tabpanel" aria-labelledby="pills-adopted-tab" tabindex="0">
      <%= render "table", animals: @animals.select { |a| a.status == "Влаштовані" } %>
    </div>
    <div class="tab-pane" id="pills-help" role="tabpanel" aria-labelledby="pills-help-tab" tabindex="0">
      <%= render "table", animals: @animals.select { |a| a.status == "Потрібна допомога" } %>
    </div>
  </div>
</div>
