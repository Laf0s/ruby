<%= form_with(model: animal) do |form| %>
  <% if animal.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% animal.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Кличка", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :species, "Вид", class: "form-label" %>
    <%= form.text_field :species, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :age, "Вік", class: "form-label" %>
    <%= form.number_field :age, class: "form-control", min: 0 %>
  </div>

  <div class="mb-3">
    <%= form.label :status, "Статус", class: "form-label" %>
    <%= form.select :status, Animal::STATUSES, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Опис", class: "form-label" %>
    <%= form.text_area :description, rows: 3, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :image, "Зображення (JPEG, PNG, WebP, до 5 МБ)", class: "form-label" %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", class: "form-control" %>
  </div>

  <%= form.submit "Зберегти", class: "btn btn-primary" %>
<% end %>
