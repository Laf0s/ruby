<% if animals.empty? %>
  <div class="alert alert-light border text-muted mb-0">
    У цій категорії записів немає.
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Кличка</th>
          <th>Вид</th>
          <th>Вік</th>
          <th>Опис</th>
          <th class="text-end">Дії</th>
        </tr>
      </thead>
      <tbody>
        <% animals.each do |animal| %>
          <tr>
            <td class="fw-semibold"><%= animal.name %></td>
            <td><%= animal.species %></td>
            <td><%= animal.age.present? ? "#{animal.age} р." : "—" %></td>
            <td class="text-muted"><%= animal.description %></td>
            <td class="text-end text-nowrap">
              <%= link_to "Переглянути", animal, class: "btn btn-sm btn-outline-primary me-1" %>
              <%= link_to "Редагувати", edit_animal_path(animal), class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
