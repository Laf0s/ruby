<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="bg-white border rounded p-4 shadow-sm">
      <h2 class="h4 border-bottom pb-2 mb-3">Реєстрація</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-3">
          <%= f.label :name, "Ім'я", class: "form-label" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "Пароль", class: "form-label" %>
          <% if @minimum_password_length %>
            <span class="form-text">(мінімум <%= @minimum_password_length %> символів)</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "Підтвердження пароля", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>

        <%= f.submit "Зареєструватися", class: "btn btn-primary" %>
      <% end %>

      <div class="mt-3 pt-2 border-top">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
